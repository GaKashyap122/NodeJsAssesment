# Copy this file to .env and fill in the values.
# Do NOT commit the real .env to git.

# --- Database ---
# Option A: Prisma Postgres (get from `npx prisma init --db` or https://console.prisma.io)
# DATABASE_URL="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"
#
# Option B: Local Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb"

# Optional: only needed if DATABASE_URL is an Accelerate URL (prisma://...)
# DIRECT_URL="postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require"

# --- App ---
PORT=8000
JWT_SECRET="change-me-in-production"
JWT_EXPIRY="1h"
